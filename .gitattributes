# Enforce LF line endings across text files for cross-platform consistency
* text=auto

*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf

*.xlsx binary
*.xlsm binary
*.xls binary
*.docx binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
